{
  "name": "design-patterns",
  "version": "1.1.0",
  "description": "Control-flow rules, Tier 0 forms and the Gang of Four design-pattern catalog, plus Pattern Check (Rule 0) hook enforcement for Claude Code.",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "scripts": {
    "test": "node hooks/__tests__/smoke.js && node hooks/__tests__/golden.js && node hooks/__tests__/crossfile.js && node hooks/__tests__/dogfood.js && node hooks/__tests__/run-matrix.js",
    "test:smoke": "node hooks/__tests__/smoke.js",
    "test:golden": "node hooks/__tests__/golden.js",
    "test:golden:update": "node hooks/__tests__/golden.js --update",
    "test:golden:ast": "node hooks/__tests__/golden.js --parser tree-sitter",
    "test:crossfile": "node hooks/__tests__/crossfile.js",
    "test:dogfood": "node hooks/__tests__/dogfood.js",
    "parsers:install": "node scripts/install-parsers.js",
    "parsers:check": "node scripts/install-parsers.js --check",
    "test:matrix": "node hooks/__tests__/run-matrix.js",
    "analyze": "node hooks/analyze-log.js",
    "bundle": "node scripts/bundle.js",
    "lint": "shellcheck install.sh uninstall.sh"
  },
  "files": [
    ".claude-plugin",
    "skills",
    "commands",
    "hooks",
    "docs",
    "scripts",
    "dist",
    "install.sh",
    "uninstall.sh",
    "settings.example.json",
    "pattern-check.config.example.json",
    "pattern-check.schema.json",
    "README.md",
    "CHANGELOG.md",
    "evals"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolffyx/design-patterns.git"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "design-patterns",
    "gang-of-four",
    "gof",
    "code-quality",
    "hooks",
    "skills"
  ],
  "dependencies": {}
}
