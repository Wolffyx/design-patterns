{
  "$schema": "./pattern-check.schema.json",

  "schema": {
    "minReasonLength": 20
  },

  "blocking": {
    "enabled": true,
    "fileExtensions": [
      "ts", "tsx", "mts", "cts",
      "py", "pyi",
      "java", "cs", "go", "rs",
      "cpp", "cc", "cxx", "hpp", "hh", "hxx", "h"
    ],
    "excludeGlobs": [
      "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx",
      "**/*.types.ts", "**/*.types.tsx", "**/*.d.ts",
      "**/test_*.py", "**/*_test.py", "**/conftest.py",
      "**/*Test.java", "**/*Tests.java", "**/*IT.java",
      "**/*Test.cs", "**/*Tests.cs", "**/*.Designer.cs", "**/*.g.cs", "**/*.generated.cs",
      "**/*_test.go", "**/*.pb.go", "**/mock_*.go",
      "**/*_test.cpp", "**/*_test.cc", "**/*Test.cpp",
      "**/tests/**", "**/*_test.rs", "**/benches/**"
    ],
    "smallEditThreshold": 10,
    "skipDirective": "// pattern-check: skip",
    "substantiveTriggers": {
      "newClass": true,
      "newInterface": true,
      "newAbstract": true,
      "newExportedFunction": true,
      "newExportedArrowConst": true,
      "newFile": true,
      "diffLineThreshold": 40
    }
  },

  "perPathRules": [
    { "glob": "**/scripts/**",   "action": "skip", "reason": "build/scripts code — no architecture concern" },
    { "glob": "**/__mocks__/**", "action": "skip", "reason": "test mocks" },
    { "glob": "**/migrations/**", "action": "skip", "reason": "generated DB migrations" },
    { "glob": "**/*_pb2.py",     "action": "skip", "reason": "generated protobuf stubs" }
  ],

  "validation": {
    "requireCitationOnExtended": true,
    "requireAntiExtendedClauseOnNewClassReject": false,
    "callerCountWarn": true,
    "callerCountThreshold": 3,
    "callerCountBudgetMs": 200,
    "enforceAntisignals": true,
    "refactorSuggestMinReasonLength": 40,
    "requireArrowOnRefactorSuggest": true
  },

  "sessionCache": {
    "enabled": true,
    "path": "~/.claude/cache/pattern-family-session.json",
    "alreadyInFamilyDays": 30
  },

  "forbiddenPatterns": [],

  "log": {
    "enabled": true,
    "path": ".claude/pattern-decision-log.jsonl",
    "blockStatsPath": ".claude/pattern-block-stats.jsonl"
  },

  "smells": {
    "enabled": true,
    "switchOnTypeMinCases": 4,
    "instanceofChainMinBranches": 3,
    "repeatedNewMinOccurrences": 3,
    "constructorMaxParams": 5,
    "godClassMinPublicMethods": 8,
    "boundaryViolationPaths": {
      "guardedPath": "",
      "forbiddenImports": [],
      "allowedPaths": [],
      "routeThroughHint": "the project's package-boundary interface"
    },
    "detectors": {
      "singleton":      { "enabled": true },
      "observer":       { "enabled": true, "minClusterSize": 3 },
      "command":        { "enabled": true },
      "templateMethod": { "enabled": true, "minAbstract": 2 }
    },
    "crossFile": {
      "enabled": false,
      "cacheTtlDays": 14,
      "cachePath": ".claude/cache/pattern-smell-corpus.json"
    }
  }
}
