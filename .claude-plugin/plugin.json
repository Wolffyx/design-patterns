{
  "name": "design-patterns",
  "description": "Always-on Gang of Four design-pattern catalog (22 patterns, refactoring.guru) plus Pattern Check (Rule 0) hook enforcement on every TypeScript edit.",
  "author": {
    "name": "wolffyx",
    "url": "https://github.com/wolffyx"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start-reminder.js\"",
            "timeout": 5,
            "statusMessage": "Loading Pattern Check (Rule 0)..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-reminder.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pattern-context-prep.js\"",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-pattern-preamble.js\"",
            "timeout": 8
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pattern-smell-detector.js\"",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/log-pattern-decision.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
